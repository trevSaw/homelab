# .env.example – Standardized Environment Variable Template
# -------------------------------------------------
# This file is committed to the repository and provides placeholders for all
# required environment variables for a service. Developers must copy this file
# to .env (which is .gitignore‑ed) and replace the placeholder values with
# real, secure values before deployment.
# -------------------------------------------------

##################################
# General
##################################
TZ=UTC
PUID=1000
PGID=1000

##################################
# Service Configuration
##################################
SERVICE_PORT=
SERVICE_HOSTNAME=

##################################
# Secrets
##################################
SERVICE_PASSWORD=change_me
SERVICE_API_KEY=change_me

##################################
# Optional
##################################
# LOG_LEVEL=info
# ADDITIONAL_OPTION=