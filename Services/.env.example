# Authentik / shared Services env template.
# Copy to Services/.env (parent of authentic/) and fill in real values.
# Never commit .env.

TZ=Etc/UTC
PUID=1000
PGID=1000
DEFAULT_DOMAIN=example.com
PATH_DATA=/mnt/monarch/appdata
PATH_CONFIG=/mnt/monarch/appdata

PG_USER=authentik
PG_DB=authentik
PG_PASS=change_me
AUTHENTIK_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
