{
  "name": "uptimekuma",
  "image": "louislam/uptime-kuma:1.23.10-alpine",
  "status": "running",
  "health": "healthy",
  "restart": "unless-stopped",
  "privileged": false,
  "user": "",
  "compose_workdir": "/var/lib/casaos/apps/uptimekuma",
  "compose_file": "/var/lib/casaos/apps/uptimekuma/docker-compose.yml",
  "mounts": [
    {
      "source": "/DATA/AppData/uptimekuma/app/data",
      "dest": "/app/data",
      "rw": true
    }
  ],
  "ports": {
    "3001/tcp": [
      {
        "HostIp": "",
        "HostPort": "3001"
      }
    ]
  },
  "network_mode": "bridge",
  "networks": [
    "bridge"
  ]
}
