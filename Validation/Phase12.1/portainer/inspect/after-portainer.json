{
  "name": "portainer",
  "image": "portainer/portainer-ce:2.33.6",
  "status": "running",
  "health": "n/a",
  "restart": "unless-stopped",
  "privileged": false,
  "user": "",
  "compose_workdir": "/home/fatherfrank/projects/homelab/services/portainer",
  "compose_file": "/home/fatherfrank/projects/homelab/services/portainer/compose.yaml",
  "mounts": [
    {
      "source": "/mnt/monarch/appdata/portainer",
      "dest": "/data",
      "rw": true,
      "mode": "rw"
