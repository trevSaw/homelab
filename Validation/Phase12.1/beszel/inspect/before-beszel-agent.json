{
  "name": "beszel-agent",
  "image": "henrygd/beszel-agent",
  "status": "running",
  "health": "n/a",
  "restart": "unless-stopped",
  "privileged": false,
  "user": "",
  "compose_workdir": "/mnt/monarch/appdata/beszel_agent",
  "compose_file": "/mnt/monarch/appdata/beszel_agent/compose.yml",
  "mounts": [
    {
      "source": "/var/run/docker.sock",
      "dest": "/var/run/docker.sock",
      "rw": false
    },
    {
      "source": "/mnt/monarch/appdata/beszel_agent/beszel_agent_data",
      "dest": "/var/lib/beszel-agent",
      "rw": true
    }
  ],
  "ports": {},
  "network_mode": "host",
  "networks": [
    "host"
  ]
}
