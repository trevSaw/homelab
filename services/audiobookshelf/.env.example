# Audiobookshelf — audiobook / podcast streaming server.
#
# No secrets required; values are inlined in compose.yaml.
# ABS does not use PUID/PGID; the container runs as user 1000:1000 via `user:`.
# Ensure /mnt/monarch/appdata/audiobookshelf and /hive/library/Audiobooks are
# owned by 1000:1000 on the host.