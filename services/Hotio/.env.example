# Hotio qBittorrent (+ VPN). Copy to .env (gitignored).
PUID=1000
PGID=1000
UMASK=002
TZ=Etc/UTC

# VPN (WireGuard config lives under /config; do not put private keys here)
VPN_ENABLED=true
VPN_CONF=wg0
VPN_LAN_NETWOK=192.168.0.0/24
VPN_ADDITIONAL_PORTS=6789/tcp,6789/udp
VPN_IP_CHECK_DELAY=10
VPN_IP_CHECK_EXIT=true
PRIVOXY_ENABLED=true
WEBUI_PORTS=8080/tcp,8080/udp
