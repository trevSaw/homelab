# Task Bridge environment template — never commit real values.
# Copy to .env.

TZ=Asia/Tokyo

# High-entropy token protecting the REST + MCP endpoints. Hermes config.yaml
# sends it as `Authorization: Bearer <token>` (mcp_servers.taskbridge.headers).
TASKBRIDGE_API_TOKEN=change-me

# Worker model: gpt-oss:20b-cloud directly via Ollama (same model KORA uses).
TASKBRIDGE_MODEL=ollama/gpt-oss:20b-cloud
TASKBRIDGE_TASK_TIMEOUT=3600
TASKBRIDGE_MAX_CONCURRENT=1

# Optional notification channels (outbound only; leave empty to disable).
TASKBRIDGE_DISCORD_WEBHOOK=
TASKBRIDGE_NTFY_URL=