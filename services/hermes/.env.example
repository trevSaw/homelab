# Hermes environment template — Phase 14.1
# Copy to .env. Never commit secrets.

TZ=Asia/Tokyo
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
OLLAMA_BASE_URL=http://ollama:11434

# --- Phase 14 Hermes migration (branch phase14-hermes-runtime) ---
# OpenAI-compatible API server platform (the Open WebUI entry point in the
# target architecture Open WebUI -> Hermes -> KORA).
# Keep API_SERVER_ENABLED=false until the Hermes path is proven and the
# cutover is approved. Generate a high-entropy API_SERVER_KEY at cutover.
API_SERVER_ENABLED=false
API_SERVER_KEY=
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
# Advertised model name; must remain KORA (identity is KORA, never Hermes).
API_SERVER_MODEL_NAME=KORA
API_SERVER_CORS_ORIGINS=

# --- Phase 22: OpenCode Go heavy-coding model provider ---
# Hermes delegates heavy coding/agent tasks to a child agent backed by OpenCode
# Go (DeepSeek Flash). The credential belongs to Hermes, not KORA. Set it here
# (services/hermes/.env is gitignored) and never commit the real key.
# Resolved by the native `opencode-go` provider:
#   endpoint  https://opencode.ai/zen/go/v1
#   api_mode  chat_completions
# The delegation target is configured in config.yaml under `delegation:`.
OPENCODE_GO_API_KEY=

# --- Phase 2: read-only live qBittorrent inspection (KORA) ---
# Populate with the qBittorrent WebUI credentials (the same account configured
# in /mnt/monarch/appdata/hotio/config/qBittorrent.conf). Values must only live
# in the gitignored services/hermes/.env — never commit them.
# Optional override for the API base URL; the default resolves the host
# published WebUI port :8080 via the container's default gateway (no network
# change). qBittorrent exposes no read-only account, so read-only enforcement
# is implemented in the KORA plugin tools (GET endpoints only).
KORA_QBIT_USER=
KORA_QBIT_PASS=
KORA_QBIT_BASE_URL=

# --- Phase 3: controlled Docker administration (KORA) ---
# KORA reaches the narrow docker-admin helper over the internal `kora-admin`
# Docker network. The shared bearer token is normally read from the Hermes
# volume file /opt/data/docker-admin.token (never committed); setting
# KORA_DOCKER_ADMIN_TOKEN here overrides the file. No docker.sock is exposed
# to Hermes.
KORA_DOCKER_ADMIN_URL=http://docker-admin:8765
KORA_DOCKER_ADMIN_TOKEN=

# --- Phase 4: Discord transport (native Hermes Discord platform) ---
# Discord is ONLY another transport into the existing KORA/Hermes pipeline.
# The bot token is a secret: it must live ONLY in this gitignored file and is
# never written to compose YAML, logs, docs, or tool output.
#
# Authorization defaults to DENY. Discord does not enable until
# DISCORD_BOT_TOKEN is set, and messages are rejected until DISCORD_ALLOWED_USERS
# (or DISCORD_ALLOWED_CHANNELS) is populated. Do NOT use allow-all.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
# Optional: restrict to explicit channel IDs (comma-separated).
DISCORD_ALLOWED_CHANNELS=
# Server channels only respond when the bot is explicitly mentioned.
DISCORD_REQUIRE_MENTION=true
# Optional: default channel ID for cron/notification delivery.
DISCORD_HOME_CHANNEL=
# Explicitly DISABLED. Discord must never fall back to open access.
DISCORD_ALLOW_ALL_USERS=false

# --- Phase 4.1: Discord slash-command sync policy ---
# "safe" (Hermes default) reconciles commands individually and, for the duration
# of that reconcile, sets discord.py's http.max_ratelimit_timeout=30. discord.py
# caches that value on each rate-limit bucket when the bucket is first created,
# so a route bucket first used during the reconcile (e.g. auto-thread creation)
# will pre-emptively raise "Too many requests" for the rest of its window even
# though Discord never rejected the request. "bulk" performs the same reconcile
# as a single bulk request and does not touch max_ratelimit_timeout. Allowed:
# safe | bulk | off.
DISCORD_COMMAND_SYNC_POLICY=bulk

# --- Phase 5: SearXNG external web research (native Hermes web provider) ---
# Optional override for the internal SearXNG instance URL. The compose file
# already defaults this to http://searxng:8080 (services/searxng, internal AI
# network, no public exposure). Hermes' native `web` toolset uses it for
# web_search when config.yaml sets `web.search_backend: searxng`. Non-secret.
SEARXNG_URL=http://searxng:8080

