# SearXNG internal research service — required variables.
# Copy to .env and set real values. .env is gitignored (never commit secrets).

# Required: instance secret used to sign/obfuscate session data.
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=change_me

# Internal-only base URL (never a public hostname).
SEARXNG_BASE_URL=http://searxng:8080/

# Timezone for log timestamps.
TZ=Asia/Tokyo
