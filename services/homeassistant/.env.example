# Home Assistant — copy to .env (gitignored). Never commit secrets.
# DockerStandard §8 / SecurityStandard: secrets and env only via approved .env files.

# Timezone (IANA). Used by the container TZ environment variable.
TZ=Etc/UTC

# Optional: set after first boot if you pin a long-lived supervisor/token for scripts.
# Do not put live tokens in git. Leave blank in .env.example.
# HOMEASSISTANT_TOKEN=

# Public hostname used by Traefik (documentation / operator reference only;
# the Host() rule is defined in compose.yaml labels).
HOMEASSISTANT_HOSTNAME=homeassistant.fatherfankscloud.uk
