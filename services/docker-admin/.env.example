# docker-admin environment template — Phase 3
# Copy to .env. Never commit secrets.

# Shared bearer token required by every authenticated endpoint. Generate with:
#   openssl rand -hex 32
# The same token is given to the KORA plugin (Hermes) via the file
# /opt/data/docker-admin.token inside the Hermes volume (never committed).
DOCKER_ADMIN_TOKEN=change-me

TZ=Asia/Tokyo
