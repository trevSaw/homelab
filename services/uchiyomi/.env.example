# Uchiyomi — environment template.
#
# Copy to .env and adjust. Uchiyomi generates and persists its own JWT/VAPID
# secrets into /config on first boot, so there are NO secrets to put here.
#
# PUID/PGID must match the shared media identity (host 1000:1000) so Uchiyomi can
# write its download folder (/library-dl) and manage files in its own library
# (/library). Leave them unset and the app runs as uid 10002 with a read-only
# library.
PUID=1000
PGID=1000
TZ=Etc/UTC

# The exact URL you open in the browser. The session cookie is bound to it, so a
# mismatch makes login silently bounce. Must match the Traefik router host.
PUBLIC_ORIGIN=https://uchiyomi.fatherfankscloud.uk

# Optional tuning (upstream defaults shown).
# SUWAYOMI_MAX_SOURCES=25
# SUWAYOMI_PAGE_CONCURRENCY=4
# BACKUP_KEEP=14
