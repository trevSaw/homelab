# Technitium DNS environment template — Phase 19
# Copy to .env and fill values. Never commit .env.

DNS_SERVER_DOMAIN=dns.mocha
DNS_SERVER_ADMIN_PASSWORD=change-me-strong-random
# Block list URLs (documented defaults; confirm against Pi-hole's exact lists)
DNS_SERVER_BLOCK_LIST_URLS=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts,https://urlhaus.abuse.ch/downloads/hostfile/,https://s3.amazonaws.com/lists.disconnect.me/simple_tracking.txt,https://s3.amazonaws.com/lists.disconnect.me/simple_ad.txt
# Comma separated forwarder addresses (temporary for validation; confirm before cutover)
DNS_SERVER_FORWARDERS=1.1.1.1,8.8.8.8
DNS_SERVER_FORWARDER_PROTOCOL=Udp
