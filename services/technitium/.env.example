# Technitium DNS environment template — Phase 19
# Copy to .env and fill values. Never commit .env.

DNS_SERVER_DOMAIN=dns.mocha
DNS_SERVER_ADMIN_PASSWORD=change-me-strong-random
# Block list URLs — confirmed 2026-08-16 (user-provided Pi-hole lists)
# Note: hagezi "hosts/pro.txt" path is 404; "adblock/pro.txt" is the same Pro list
# in AdBlock format (Technitium parses ||domain^ syntax natively).
DNS_SERVER_BLOCK_LIST_URLS=https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/pro.txt,https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
# Comma separated forwarder addresses (temporary for validation; confirm before cutover)
DNS_SERVER_FORWARDERS=1.1.1.1,8.8.8.8
DNS_SERVER_FORWARDER_PROTOCOL=Udp
