# CouchDB (Obsidian Self-hosted LiveSync) environment template
# Copy to .env and fill values. Never commit .env.

TZ=Asia/Tokyo

# CouchDB admin — INFRASTRUCTURE ONLY. Never used by Obsidian clients.
COUCHDB_USER=change-me-admin
COUCHDB_PASSWORD=change-me-strong-random

# LiveSync database and client/service account.
# obsidian-sync is member-only on COUCHDB_DB (least privilege).
COUCHDB_DB=obsidian
SYNC_USER=obsidian-sync
SYNC_PASSWORD=change-me-strong-random
