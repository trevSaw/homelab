# SparkyFitness environment template — homelab deployment
# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with: openssl rand -hex 24 / openssl rand -hex 32

TZ=Asia/Tokyo
NODE_ENV=production

# --- PostgreSQL ---
SPARKY_FITNESS_DB_NAME=sparkyfitness_db
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_PASSWORD=change_me_db_password
SPARKY_FITNESS_APP_DB_USER=sparky_app
SPARKY_FITNESS_APP_DB_PASSWORD=change_me_app_db_password
SPARKY_FITNESS_DB_HOST=sparkyfitness-db
SPARKY_FITNESS_DB_PORT=5432

# --- Backend / Frontend ---
SPARKY_FITNESS_SERVER_HOST=sparkyfitness-server
SPARKY_FITNESS_SERVER_PORT=3010
SPARKY_FITNESS_FRONTEND_URL=https://sparkyfitness.fatherfankscloud.uk
SPARKY_FITNESS_PUBLIC_API_DOCS=false
SPARKY_FITNESS_LOG_LEVEL=INFO
SPARKY_FITNESS_DISABLE_SIGNUP=false
SPARKY_FITNESS_ADMIN_EMAIL=you@example.com
SPARKY_FITNESS_FORCE_EMAIL_LOGIN=true
ALLOW_PRIVATE_NETWORK_CORS=true
ALLOW_PRIVATE_NETWORK_AI=true

# --- Security (generate with openssl rand -hex 32) ---
SPARKY_FITNESS_API_ENCRYPTION_KEY=change_me_64_hex_chars
BETTER_AUTH_SECRET=change_me_strong_secret

# --- Email (optional; leave commented to disable) ---
#SPARKY_FITNESS_EMAIL_HOST=
#SPARKY_FITNESS_EMAIL_PORT=
#SPARKY_FITNESS_EMAIL_SECURE=
#SPARKY_FITNESS_EMAIL_USER=
#SPARKY_FITNESS_EMAIL_PASS=
#SPARKY_FITNESS_EMAIL_FROM=
