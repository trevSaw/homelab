# KORA Runtime environment template — Phase 14.3
# Copy to .env and adjust. Do not commit .env.

TZ=Asia/Tokyo
OLLAMA_BASE_URL=http://ollama:11434
KORA_DEFAULT_MODEL=qwen3:8b
KORA_LOG_LEVEL=INFO

# Generate distinct high-entropy values. Never commit real tokens.
KORA_MEMORY_READ_TOKEN=replace-with-read-token
KORA_MEMORY_APPROVAL_TOKEN=replace-with-user-approval-token
KORA_MEMORY_OPERATOR_TOKEN=replace-with-operator-token

KORA_MEMORY_DB_PATH=/data/memory-runtime.sqlite3
KORA_HONCHO_BASE_URL=http://honcho-api:8000
KORA_HONCHO_WORKSPACE_ID=kora
KORA_HONCHO_OBSERVER_ID=kora
KORA_HONCHO_OBSERVED_ID=user
# Optional when Honcho API authentication is enabled:
KORA_HONCHO_BEARER_TOKEN=

# Phase 14.3 — Knowledge Platform
KORA_EMBEDDING_MODEL=nomic-embed-text
KORA_CHROMA_BASE_URL=http://chromadb:8000
KORA_CHROMA_COLLECTION=kora_knowledge
KORA_INDEX_METADATA_DB_PATH=/data/knowledge-index.sqlite3
