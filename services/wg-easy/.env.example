# wg-easy dedicated env template — copy to .env and fill in real values
# (gitignored; never commit secrets)

# Public endpoint clients connect to. Use your current WAN IP or a DDNS hostname.
WG_HOST=YOUR_WAN_IP_OR_DDNS
# Web admin UI password — bcrypt hash (generate with: htpasswd -bnBC 10 "" 'yourpass')
PASSWORD_HASH=YOUR_BCRYPT_HASH
# DNS pushed to clients: Technitium (LAN IP) so fatherfankscloud.uk resolves via split horizon
WG_DEFAULT_DNS=192.168.50.44
# Full-tunnel for the diagnostic; tighten later if desired
WG_ALLOWED_IPS=0.0.0.0/0, ::/0
TZ=Asia/Tokyo